generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model annual_inventories {
  id           Int                      @id @default(autoincrement())
  year         Int
  sectionId    Int
  section      sections                 @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  status       String                   @default("NOT_STARTED")
  completedAt  DateTime?
  items        inventory_check_items[]
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime

  @@index([year, sectionId])
  @@index([status])
}

model inventory_check_items {
  id            Int                  @id @default(autoincrement())
  inventoryId   Int
  inventory     annual_inventories   @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  deviceId      Int
  device        devices              @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  found         Boolean              @default(false)
  locationFound String?
  status        String               @default("PENDING_VERIFICATION")
  createdAt     DateTime             @default(now())

  @@index([inventoryId])
  @@index([deviceId])
  @@index([status])
}

model audit_logs {
  id        Int      @id @default(autoincrement())
  userId    Int?
  action    String
  entity    String
  entityId  String?
  changes   Json?
  ipAddress String?
  userAgent String?
  timestamp DateTime @default(now())
  users     users?   @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([timestamp])
  @@index([userId])
  @@index([entity, timestamp])
}

model consumables {
  id                 Int                  @id @default(autoincrement())
  name               String
  model              String?
  manufacturer       String?
  unitOfMeasure      String               @default("buc")
  quantity           Int                  @default(0)
  minQuantity        Int                  @default(0)
  expiryDate         DateTime?
  location           String?
  notes              String?
  isDeleted          Boolean              @default(false)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime
  device_consumables device_consumables[]

  @@index([name])
  @@index([quantity])
  @@index([isDeleted])
}

model device_consumables {
  deviceId     Int
  consumableId Int
  createdAt    DateTime    @default(now())
  consumables  consumables @relation(fields: [consumableId], references: [id], onDelete: Cascade)
  devices      devices     @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@id([deviceId, consumableId])
}

model devices {
  id                     Int                   @id @default(autoincrement())
  inventoryNumber        String                @unique
  serialNumber           String?
  name                   String
  model                  String?
  manufacturer           String?
  countryOfOrigin        String?
  yearMade               Int?
  riskClass              RiskClass?
  ceMarking              String?
  cndCode                String?
  status                 DeviceStatus          @default(FUNCTIONAL)
  acquisitionDate        DateTime?
  installationDate       DateTime?
  warrantyEndDate        DateTime?
  decommissionDate       DateTime?
  acquisitionValue       Decimal?
  residualValue          Decimal?
  currency               String                @default("MDL")
  financingSource        String?               // Source of financing (e.g., State Budget, Foundation, Donation)
  destination            String?               // Intended use/destination (e.g., Surgery Department)
  electricalSafetyClass  String?               // Electrical safety class per IEC 60601 (e.g., Class I, Class II)
  voltage                String?
  frequency              String?
  power                  String?
  accessories            String?
  maintenanceFreq        Int?
  nextMaintenanceAt      DateTime?
  lastMaintenanceAt      DateTime?
  requiresVerification   Boolean              @default(false)
  verificationType       String?              // LABORATOR | METROLOGIC | NONE
  verificationFreqMonths Int?
  lastVerificationAt     DateTime?
  nextVerificationAt     DateTime?
  sectionId              Int?
  room                   String?
  manualUrl              String?
  certificateUrl         String?
  invoiceUrl             String?
  passportUrl            String?
  notes                  String?
  createdById            Int?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime
  device_consumables     device_consumables[]
  inventory_check_items  inventory_check_items[]
  users                  users?                @relation(fields: [createdById], references: [id])
  sections               sections?             @relation(fields: [sectionId], references: [id])
  incidents              incidents[]
  maintenance_records    maintenance_records[]
  maintenance_plans      maintenance_plans[]
  mpp_executions        mpp_executions[]
  repair_tickets        repair_tickets[]
  verifications         verifications[]
  documents             documents[]
  decommission_records  decommission_records[]
  duty_log_entries      duty_log_entries[]
  commissioning_records commissioning_records[]

  @@index([inventoryNumber])
  @@index([nextMaintenanceAt])
  @@index([sectionId])
  @@index([status])
  @@index([status, sectionId])
  @@index([name])
}

model documents {
  id                Int              @id @default(autoincrement())
  title             String
  category          DocumentCategory
  fileUrl           String
  fileSize          Int?
  mimeType          String?
  fileHash          String?          // SHA-256 hex — integrity verification
  version           String           @default("1.0")
  isCurrent         Boolean          @default(true)
  isDeleted         Boolean          @default(false)
  previousVersionId Int?
  uploadedById      Int?
  deviceId          Int?
  issuer            String?          // emitent (CERTIFICAT/CONTRACT)
  validFrom         DateTime?        // valabil de la
  validUntil        DateTime?        // expiră la (CERTIFICAT/CONTRACT/LEGISLATIE)
  reviewAt          DateTime?        // dată de revizuire (PROCEDURA_MDM/FORMULAR)
  description       String?
  tags              String[]
  uploadedAt        DateTime         @default(now())
  updatedAt         DateTime
  documents         documents?       @relation("documentsTodocuments", fields: [previousVersionId], references: [id])
  other_documents   documents[]      @relation("documentsTodocuments")
  uploadedBy        users?           @relation(fields: [uploadedById], references: [id])
  device            devices?         @relation(fields: [deviceId], references: [id])

  @@index([category])
  @@index([title])
  @@index([isCurrent])
  @@index([isDeleted])
  @@index([deviceId])
  @@index([validUntil])
  @@index([fileHash])
}

model incidents {
  id               Int              @id @default(autoincrement())
  deviceId         Int
  sectionId        Int?
  occurredAt       DateTime
  reportedAt       DateTime         @default(now())
  description      String
  severity         IncidentSeverity
  status           IncidentStatus   @default(DESCHIS)
  patientAffected  Boolean          @default(false)
  patientHarm      String?
  rootCause        String?
  correctiveAction String?
  preventiveAction String?
  resolvedAt       DateTime?
  reportedToAmdm   Boolean          @default(false)
  amdmReportDate   DateTime?
  amdmReportRef    String?
  reportedById     Int?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime
  devices          devices          @relation(fields: [deviceId], references: [id])
  users            users?           @relation(fields: [reportedById], references: [id])
  sections         sections?        @relation(fields: [sectionId], references: [id])

  @@index([deviceId])
  @@index([occurredAt])
  @@index([severity])
  @@index([status])
}

model maintenance_records {
  id              Int             @id @default(autoincrement())
  deviceId        Int
  type            MaintenanceType
  scheduledDate   DateTime?
  executedDate    DateTime
  duration        Decimal?
  description     String
  partsReplaced   String?
  consumablesUsed String?
  result          String?
  cost            Decimal?
  externalService Boolean         @default(false)
  serviceProvider String?
  reportUrl       String?
  performedById   Int?
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime
  devices         devices         @relation(fields: [deviceId], references: [id])
  users           users?          @relation(fields: [performedById], references: [id])

  @@index([deviceId])
  @@index([executedDate])
  @@index([type])
}

model refresh_tokens {
  id         String    @id
  tokenHash  String    @unique
  userId     Int
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?
  userAgent  String?
  ipAddress  String?
  createdAt  DateTime  @default(now())
  users      users     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId])
}

model sections {
  id                    Int                  @id @default(autoincrement())
  name                  String               @unique
  code                  String?              @unique
  floor                 String?
  description           String?
  isActive              Boolean              @default(true)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime
  devices               devices[]
  incidents             incidents[]
  users                 users[]
  annual_inventories    annual_inventories[]
  procurement_plans     procurement_plans[]
}

model users {
  id                  Int                   @id @default(autoincrement())
  email               String                @unique
  username            String                @unique
  passwordHash        String
  fullName            String?
  role                UserRole              @default(BIOINGINER)
  isActive            Boolean               @default(true)
  mustChangePassword  Boolean               @default(false)
  lastLoginAt         DateTime?
  failedLoginAttempts Int                   @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime
  sectionId           Int?
  audit_logs          audit_logs[]
  devices             devices[]
  incidents           incidents[]
  maintenance_records maintenance_records[]
  mpp_executions      mpp_executions[]
  repair_tickets      repair_tickets[]
  verifications       verifications[]
  documents           documents[]
  decommission_records decommission_records[]
  duty_log_entries     duty_log_entries[]
  procurement_plans    procurement_plans[]
  commissioning_records commissioning_records[]
  refresh_tokens      refresh_tokens[]
  sections            sections?             @relation(fields: [sectionId], references: [id])

  @@index([email])
  @@index([username])
}

// Phase 3: Maintenance Management Models
model maintenance_plans {
  id              Int       @id @default(autoincrement())
  deviceId        Int
  year            Int
  frequency       String    // LUNAR|BIMESTRIAL|TRIMESTRIAL|SEMESTRIAL|ANUAL
  responsibleName String
  responsibleAffil String?
  months          Int[]     // [1..12] lunile marcate
  approvedBy      String?
  approvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime
  device          devices   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  occurrences     mpp_occurrences[]
  @@unique([deviceId, year])
  @@index([year])
}

model mpp_occurrences {
  id            Int       @id @default(autoincrement())
  planId        Int
  deviceId      Int
  scheduledDate DateTime
  status        String    @default("PROGRAMAT") // PROGRAMAT|SCADENT|DEPASIT|EFECTUAT
  rescheduledTo DateTime?
  rescheduleReason String?
  executionId   Int?
  createdAt     DateTime  @default(now())
  plan          maintenance_plans @relation(fields: [planId], references: [id], onDelete: Cascade)
  @@index([deviceId])
  @@index([status])
  @@index([scheduledDate])
}

model mpp_executions {
  id              Int       @id @default(autoincrement())
  deviceId        Int
  occurrenceId    Int?
  executedDate    DateTime
  durationMinutes Int?
  checklist       Json
  consumablesUsed Json?
  result          String    // FUNCTIONAL | DEFECT
  engineerName    String
  signature       String?
  notes           String?
  createdById     Int?
  createdAt       DateTime  @default(now())
  device          devices   @relation(fields: [deviceId], references: [id])
  createdBy       users?    @relation(fields: [createdById], references: [id])
  @@index([deviceId])
  @@index([executedDate])
}

model repair_tickets {
  id                  Int       @id @default(autoincrement())
  ticketNumber        String    @unique
  deviceId            Int
  sectionId           Int?
  reportedAt          DateTime  @default(now())
  reportedBy          String
  faultDescription    String
  priority            String    @default("NORMAL") // SCAZUT|NORMAL|RIDICAT|URGENT
  status              String    @default("DESCHIS") // DESCHIS→IN_LUCRU→REZOLVAT→TESTAT→INCHIS (+ ESCALADAT)
  faultCause          String?
  faultCategory      String?
  repairReport        String?   // Raport reparație (observații)
  actionsTaken        String?   // Acțiuni concrete executate
  durationHours       Decimal?  // Durata reparației în ore
  operations          Json?     // [{date, timeStart, timeEnd, operation, engineer, signature}, ...] — detailed work log
  partsUsed           Json?     // [{description, qty, costUnit}, ...]
  totalCost           Decimal?  // Suma piese
  functionalTest      String?   // FUNCTIONAL | NEFUNCTIONAL
  beforePhoto         String?   // Base64 sau URL
  afterPhoto          String?   // Base64 sau URL
  engineerName        String?
  engineerSignature   String?   // Base64 PNG
  managerSignature    String?   // Base64 PNG
  externalized        Boolean   @default(false)
  resolvedAt          DateTime?
  createdById         Int?
  updatedAt           DateTime
  device              devices   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  createdBy           users?    @relation(fields: [createdById], references: [id])
  @@index([status])
  @@index([deviceId])
  @@index([priority])
}

model verifications {
  id            Int       @id @default(autoincrement())
  deviceId      Int
  type          String    // LABORATOR | METROLOGIC
  performedAt   DateTime
  validUntil    DateTime
  result        String    // CONFORM | NECONFORM
  certificateNo String?
  inspectionBody String?
  reportUrl     String?
  notes         String?
  createdById   Int?
  createdAt     DateTime  @default(now())
  device        devices   @relation(fields: [deviceId], references: [id])
  createdBy     users?    @relation(fields: [createdById], references: [id])
  @@index([deviceId])
  @@index([validUntil])
  @@index([result])
}

model service_providers {
  id        Int      @id @default(autoincrement())
  name      String
  contact   String?
  email     String?
  phone     String?
  ratingAvg Decimal?
  createdAt DateTime @default(now())
  updatedAt DateTime
  contracts service_contracts[]
  ratings   provider_ratings[]
}

model service_contracts {
  id                 Int      @id @default(autoincrement())
  providerId         Int
  contractNo         String   @unique
  startDate          DateTime
  endDate            DateTime
  value              Decimal?
  currency           String   @default("MDL")
  slaHours           Int?
  scope              String?
  coveredDeviceIds   Int[]    // JSON array of device IDs covered by this contract
  createdAt          DateTime @default(now())
  updatedAt          DateTime
  provider           service_providers @relation(fields: [providerId], references: [id], onDelete: Cascade)
  @@index([endDate])
  @@index([providerId])
}

model provider_ratings {
  id         Int      @id @default(autoincrement())
  providerId Int
  score      Int      // 1-5
  comment    String?
  createdAt  DateTime @default(now())
  provider   service_providers @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

model decommission_records {
  id                Int       @id @default(autoincrement())
  deviceId          Int
  type              String    // DEFECTARE | CONSERVARE | CASARE
  nonUsageDate      DateTime?
  normativeLifespan String?
  commissioningDate DateTime?
  nominalPrice      Decimal?
  currentValue      Decimal?
  technicalState    String?
  cause             String?
  notes             String?
  responsibleName   String?
  sectionChief      String?
  engineerName      String?
  sibmChief         String?
  recyclingInfo     String?
  createdById       Int?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime
  device            devices   @relation(fields: [deviceId], references: [id])
  createdBy         users?    @relation(fields: [createdById], references: [id])
  @@index([deviceId])
  @@index([type])
}

model duty_log_entries {
  id               Int       @id @default(autoincrement())
  deviceId         Int?
  deviceName       String
  reportedAt       DateTime  @default(now())
  faultDescription String
  reportedBy       String
  resolution       String?
  resolvedAt       DateTime?
  engineerName     String?
  repairTicketId   Int?
  createdById      Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime
  device           devices?  @relation(fields: [deviceId], references: [id])
  createdBy        users?    @relation(fields: [createdById], references: [id])
  @@index([deviceId])
  @@index([reportedAt])
}

model procurement_plans {
  id            Int       @id @default(autoincrement())
  year          Int
  sectionId     Int?
  type          String    // DM | CONSUMABIL
  status        String    @default("DRAFT")   // DRAFT|COORDONAT|APROBAT
  elaboratedBy  String?
  coordSection  String?
  coordSibm     String?
  approvedAt    DateTime?
  totalAmount   Decimal?
  createdById   Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime
  section       sections? @relation(fields: [sectionId], references: [id])
  createdBy     users?    @relation(fields: [createdById], references: [id])
  items         procurement_items[]
  @@index([year])
  @@index([type])
  @@index([status])
}

model procurement_items {
  id            Int       @id @default(autoincrement())
  planId        Int
  name          String
  specification String?
  quantity      Int       @default(1)
  unit          String?
  funding       String?
  unitPrice     Decimal?
  totalPrice    Decimal?
  createdAt     DateTime  @default(now())
  plan          procurement_plans @relation(fields: [planId], references: [id], onDelete: Cascade)
  @@index([planId])
}

model commissioning_records {
  id                Int       @id @default(autoincrement())
  deviceId          Int
  installDate       DateTime?
  warrantyMonths    Int?
  contractNo        String?
  contractDate      DateTime?
  conformityOk      Boolean   @default(false)
  operationTestOk   Boolean   @default(false)
  operationManual   Boolean   @default(false)
  serviceManual     Boolean   @default(false)
  trainingDone      Boolean   @default(false)
  trainees          Json?
  commissionMembers String?
  commissionDecision String?
  comments          String?
  handoverActNo     String?
  supplier          String?
  createdById       Int?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime
  device            devices   @relation(fields: [deviceId], references: [id])
  createdBy         users?    @relation(fields: [createdById], references: [id])
  @@index([deviceId])
}

enum DeviceStatus {
  FUNCTIONAL
  IN_REPARATIE
  DEFECT
  CASAT
  CONSERVAT
  IMPRUMUTAT
  REZERVA
}

enum DocumentCategory {
  PROCEDURA_MDM
  FORMULAR
  LEGISLATIE
  MANUAL_TEHNIC
  CERTIFICAT
  CONTRACT
  RAPORT
  ALTUL
}

enum IncidentSeverity {
  NEAR_MISS
  MINOR
  MODERAT
  GRAV
  CRITIC
}

enum IncidentStatus {
  DESCHIS
  IN_LUCRU
  REZOLVAT
  INCHIS
  ESCALADAT_AMDM
}

enum MaintenanceType {
  PREVENTIVA
  CORECTIVA
  VERIFICARE
  CALIBRARE
}

enum RiskClass {
  I
  IIa
  IIb
  III
}

enum UserRole {
  ADMIN
  BIOINGINER
  MANAGER
  MEDIC
  VIEWER
}
